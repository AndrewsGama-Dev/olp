# Copie este arquivo para .config e preencha as credenciais reais.
# NUNCA commite o .config com tokens/senhas.

[APISOURCE]
token = "COLE_AQUI_O_JWT_DA_ECONTADOR"

[FILTROS]
# IDs eContador. Um ID ou varios separados por virgula. Vazio = todas as empresas do token.
codigo_empresa = 71,72
# IDs de departamento que nao importam (nem o departamento nem os funcionarios). Vazio = nenhum.
departamentos_ignorar =
# true = usa demissoes_matricula_processados.txt (nao reenvia)
historico_demissoes = true

[MODULOS]
# true = executa | false = pula (usado pelo main.py / integrador.sh)
empresas = false
departamentos = true
cargos = true
funcionarios = true
afastamentos = true
demissoes = true

[AFASTAMENTOS]
# ID-AFASTAMENTO do ifPonto. Descricao eContador -> chave.
codigo_padrao = 1022
# Ferias
ferias = 1011
# C.A.T
cat = 1013
# Beneficio
beneficio = 1014
# S.A.T
sat = 1015
# Atestado
atestado = 1016
# Servico Militar
servico_militar = 1017
# Abandono de emprego
abandono_emprego = 1018
# Suspensao contrato (Rescisao Indireta)
suspensao_contrato = 1019
# Descricao desconhecida
outros = 1020

[APITARGET]
url = https://stou.ifractal.com.br/olp/rest/
integracao = gotech
token_base = COLE_AQUI_O_TOKEN_BASE_IFRACTAL
campo_chave = cpf

[SOAP]
# Legado. O fluxo padrao de demissao hoje e REST, nao SOAP.
url = https://awstou.ifractal.com.br/ws_ifPonto.php
client_id = olp
usuario = gotech
senha = COLE_AQUI_A_SENHA_SOAP
